DATABASE_URL=sakuravel:password@tcp(localhost:3306)/sakuravel?parseTime=true&charset=utf8mb4
PORT=8080

# CORS で許可するフロントエンドのオリジン。
# 未設定なら CORS ヘッダを一切付けない（リバースプロキシで単一オリジンにする構成用）。
# フロントと API が別オリジンになるローカル構成でのみ指定する。
ALLOWED_ORIGIN=http://localhost:3000

# HTTPS 配信時は true。セッションCookieに Secure が付く。
COOKIE_SECURE=false

# セッションCookieの SameSite 属性。lax（既定） / none / strict。
# none はフロントと API が別オリジンになる構成でのみ使う（Secure が前提）。
COOKIE_SAMESITE=lax
