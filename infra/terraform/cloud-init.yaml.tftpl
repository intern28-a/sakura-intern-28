#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
password: ${password}
chpasswd:
  expire: false
ssh_pwauth: true
%{ if ssh_public_key != "" ~}
ssh_authorized_keys:
  - ${ssh_public_key}
%{ endif ~}

package_update: false
package_upgrade: false

write_files:
  - path: /usr/local/bin/configure-nic.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu

      # NIC の並びはサーバへの接続順 (ifindex 順)。グローバル側
      # (共有セグメント / ルータ+スイッチ) は API 制約で必ず1本目になる:
      #   "Only the first interface can be connected to router+switches
      #    or shared segments"
      # よって全ノードで
      #   1本目 = グローバル側 / 2本目 = app スイッチ
      # と決め打ちできる。デフォルトルートの有無では判別できない
      # (ルータ+スイッチ は DHCP を提供しないため、ブート直後には
      #  どちらの NIC にも経路が無いことがある)。
      ifaces="$(ip -o link show | awk -F': ' '{print $2}' | grep -Ev '^(lo|docker0)$')"
      public_if="$(echo "$ifaces" | sed -n '1p')"
      private_if="$(echo "$ifaces" | sed -n '2p')"

      if [ -z "$public_if" ] || [ -z "$private_if" ]; then
        echo "expected two interfaces, got: $ifaces" >&2
        exit 1
      fi

      cat >/etc/netplan/60-nic.yaml <<NETPLAN
      network:
        version: 2
        ethernets:
%{ if has_public_nic ~}
          $${public_if}:
            dhcp4: false
            addresses:
              - ${public_ip}/${public_prefix_length}
            routes:
              - to: default
                via: ${public_gateway}
            nameservers:
              addresses: [${join(", ", dns_servers)}]
%{ endif ~}
          $${private_if}:
            dhcp4: false
            addresses:
              - ${private_ip}/${private_prefix_length}
      NETPLAN

      chmod 600 /etc/netplan/60-nic.yaml
      netplan apply

%{ if has_public_nic ~}
  # ------------------------------------------------------------------
  # DSR ロードバランサの実サーバ設定 (node-02〜05)
  # TODO: 本来は Ansible で管理する。いまは初期構築のため cloud-init に置く。
  #       cloud-init は初回起動時にしか走らないので、既存ノードへの変更は
  #       Ansible 側 (infra/ansible) から当てること。
  # ------------------------------------------------------------------
  - path: /etc/sysctl.d/99-dsr.conf
    content: |
      # lo に付けた VIP でも、Linux は既定で ethernet 側から ARP 応答してしまう。
      # 抑止しないと VIP の ARP に実サーバが答え、ロードバランサを素通りして
      # 特定の1台に固定される (分散しているように見えて分散していない状態)。
      # カーネルは max(all, インターフェース個別) を採用するので all だけで足りる。
      net.ipv4.conf.all.arp_ignore = 1
      net.ipv4.conf.all.arp_announce = 2

  - path: /etc/systemd/system/dsr-vip.service
    content: |
      [Unit]
      # DSR では宛先IPが VIP のまま届くため、VIP を自分のアドレスとして
      # 持っていないとパケットを破棄してしまう。
      # また Docker の PREROUTING は `-m addrtype --dst-type LOCAL -j DOCKER` で
      # 条件付けされているので、VIP がローカル扱いにならないと公開ポート
      # ${dsr_port} の DNAT も発火しない。
      Description=Assign DSR loadbalancer VIP to loopback
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      # replace なので再実行しても重複しない
      ExecStart=/usr/sbin/ip addr replace ${dsr_vip}/32 dev lo
      ExecStop=-/usr/sbin/ip addr del ${dsr_vip}/32 dev lo

      [Install]
      WantedBy=multi-user.target

%{ endif ~}
  - path: /usr/local/bin/wait-for-internet.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      i=0
      until curl -fsS -m 5 -o /dev/null https://get.docker.com; do
        i=$((i + 1))
        if [ "$i" -ge 60 ]; then
          echo "no internet connectivity after 10 minutes" >&2
          exit 1
        fi
        echo "waiting for internet connectivity ($i/60)"
        sleep 10
      done

runcmd:
  - /usr/local/bin/configure-nic.sh
%{ if has_public_nic ~}
  # ARP 抑止を先に効かせてから VIP を付ける。逆順だと VIP を付けた瞬間から
  # ARP 応答してしまう窓ができる。
  - sysctl --system
  - systemctl daemon-reload
  - systemctl enable --now dsr-vip.service
%{ endif ~}
  - /usr/local/bin/wait-for-internet.sh
  - DEBIAN_FRONTEND=noninteractive apt-get update
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
