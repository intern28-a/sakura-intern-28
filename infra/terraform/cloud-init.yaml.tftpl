#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
password: ${password}
chpasswd:
  expire: false
ssh_pwauth: true
%{ if ssh_public_key != "" ~}
ssh_authorized_keys:
  - ${ssh_public_key}
%{ endif ~}

package_update: false
package_upgrade: false

write_files:
  - path: /usr/local/bin/configure-nic.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu

%{ if is_gateway ~}
      # 共有セグメント側 (デフォルトルートを持つ NIC) を特定し、
      # それ以外をプライベート NIC とみなす。
      public_if="$(ip route show default | awk '{print $5; exit}')"
      private_if="$(ls /sys/class/net | grep -Ev '^(lo|docker0)$' | grep -vx "$public_if" | head -n1)"
%{ else ~}
      # プライベート専用ノード。NIC は app スイッチの1本だけ。
      private_if="$(ls /sys/class/net | grep -Ev '^(lo|docker0)$' | head -n1)"
%{ endif ~}

      if [ -z "$private_if" ]; then
        echo "private interface not found" >&2
        exit 1
      fi

      cat >/etc/netplan/60-private-nic.yaml <<NETPLAN
      network:
        version: 2
        ethernets:
          $${private_if}:
            dhcp4: false
            addresses:
              - ${private_ip}/${prefix_length}
%{ if !is_gateway ~}
            routes:
              - to: default
                via: ${gateway_ip}
            nameservers:
              addresses: [${join(", ", dns_servers)}]
%{ endif ~}
      NETPLAN

      chmod 600 /etc/netplan/60-private-nic.yaml
      netplan apply

%{ if is_gateway ~}
      # node-02〜05 はグローバルIPを持たないため、このノードが NAT ゲートウェイ
      # として ${private_cidr} からの通信を共有セグメントへ出す。
  - path: /usr/local/bin/setup-nat.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      public_if="$(ip route show default | awk '{print $5; exit}')"
      sysctl -w net.ipv4.ip_forward=1
      echo 'net.ipv4.ip_forward=1' >/etc/sysctl.d/99-nat.conf
      iptables -t nat -C POSTROUTING -s ${private_cidr} -o "$public_if" -j MASQUERADE 2>/dev/null \
        || iptables -t nat -A POSTROUTING -s ${private_cidr} -o "$public_if" -j MASQUERADE

      # TODO: 本来は Ansible で管理する。いまは動作確認のため cloud-init に置く。
      # VIP は app セグメント内のプライベートアドレスで、このスイッチにはルータが無い。
      # グローバルIPを持つのはこのノードだけなので、外部から来た :${dsr_lb_port} を
      # DSR ロードバランサの VIP へ転送する入口もここが兼ねる。
      # 戻りは実サーバ → default gw (このノード) と返り、conntrack が DNAT を
      # 逆変換するため SNAT は不要 (established は nat チェーンを通らないので
      # 上の MASQUERADE も二重には効かない)。
      iptables -t nat -C PREROUTING -i "$public_if" -p tcp --dport ${dsr_lb_port} -j DNAT --to-destination ${dsr_lb_vip}:${dsr_lb_port} 2>/dev/null \
        || iptables -t nat -A PREROUTING -i "$public_if" -p tcp --dport ${dsr_lb_port} -j DNAT --to-destination ${dsr_lb_vip}:${dsr_lb_port}

      # 再起動後もルールを残す
      echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections
      echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections
      DEBIAN_FRONTEND=noninteractive apt-get update
      DEBIAN_FRONTEND=noninteractive apt-get install -y iptables-persistent
      netfilter-persistent save
%{ endif ~}
%{ if !is_gateway ~}
  # ------------------------------------------------------------------
  # DSR ロードバランサの実サーバ設定 (node-02〜05)
  # TODO: 本来は Ansible で管理する。いまは動作確認のため cloud-init に置く。
  # ------------------------------------------------------------------
  - path: /etc/sysctl.d/99-dsr.conf
    content: |
      # lo に付けた VIP でも、Linux は既定で ethernet 側から ARP 応答してしまう。
      # 抑止しないと VIP の ARP に実サーバが答え、ロードバランサを素通りして
      # 特定の1台に固定される (分散しているように見えて分散していない状態)。
      # カーネルは max(all, インターフェース個別) を採用するので all だけで足りる。
      net.ipv4.conf.all.arp_ignore = 1
      net.ipv4.conf.all.arp_announce = 2

  - path: /etc/systemd/system/dsr-vip.service
    content: |
      [Unit]
      # DSR では宛先IPが VIP のまま届くため、VIP を自分のアドレスとして
      # 持っていないとパケットを破棄してしまう。
      # また Docker の PREROUTING は `-m addrtype --dst-type LOCAL -j DOCKER` で
      # 条件付けされているので、VIP がローカル扱いにならないと公開ポートの
      # DNAT も発火しない。
      Description=Assign DSR loadbalancer VIP to loopback
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      # replace なので再実行しても重複しない
      ExecStart=/usr/sbin/ip addr replace ${dsr_lb_vip}/32 dev lo
      ExecStop=-/usr/sbin/ip addr del ${dsr_lb_vip}/32 dev lo

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/dsr-echo-server.py
    permissions: '0755'
    content: |
      #!/usr/bin/env python3
      # TODO: 分散の動作確認用の仮リスナー。本物の api ではない。
      # DB アプライアンスへのスキーマ投入が済んだら compose.reg.yml の api
      # コンテナに置き換え、dsr-echo.service は停止・無効化する。
      #
      # ホスト名を返すので、node-01 から
      #   for i in $(seq 20); do curl -s http://${dsr_lb_vip}:${dsr_lb_port}; echo; done
      # を回すと node-02〜05 にばらけているかがそのまま見える。
      #
      # ヘルスチェックは実サーバIP (192.168.1.12 等) の :${dsr_lb_port} に、
      # 振り分けられた通信は VIP (${dsr_lb_vip}) の :${dsr_lb_port} に届くので、
      # 0.0.0.0 で待ち受けて両方を受ける。
      import http.server
      import socket

      BODY = socket.gethostname().encode() + b"\n"


      class Handler(http.server.BaseHTTPRequestHandler):
          # パスに関わらず 200 を返す (ヘルスチェックを http に切り替えても通るように)
          def do_GET(self):
              self.send_response(200)
              self.send_header("Content-Type", "text/plain")
              self.send_header("Content-Length", str(len(BODY)))
              self.end_headers()
              self.wfile.write(BODY)

          def log_message(self, *args):
              pass


      if __name__ == "__main__":
          http.server.ThreadingHTTPServer(("0.0.0.0", ${dsr_lb_port}), Handler).serve_forever()

  - path: /etc/systemd/system/dsr-echo.service
    content: |
      [Unit]
      Description=Temporary :${dsr_lb_port} listener for DSR loadbalancer verification
      After=network-online.target dsr-vip.service
      Wants=network-online.target

      [Service]
      Type=simple
      ExecStart=/usr/bin/python3 /usr/local/bin/dsr-echo-server.py
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target

%{ endif ~}
  - path: /usr/local/bin/wait-for-internet.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      i=0
      until curl -fsS -m 5 -o /dev/null https://get.docker.com; do
        i=$((i + 1))
        if [ "$i" -ge 60 ]; then
          echo "no internet connectivity after 10 minutes" >&2
          exit 1
        fi
        echo "waiting for internet connectivity via ${gateway_ip} ($i/60)"
        sleep 10
      done

runcmd:
  - /usr/local/bin/configure-nic.sh
%{ if !is_gateway ~}
  # ARP 抑止を先に効かせてから VIP を付ける。逆順だと VIP を付けた瞬間から
  # ARP 応答してしまう窓ができる。
  - sysctl --system
  - systemctl daemon-reload
  - systemctl enable --now dsr-vip.service
  - systemctl enable --now dsr-echo.service
%{ endif ~}
%{ if is_gateway ~}
  - /usr/local/bin/setup-nat.sh
%{ endif ~}
  - /usr/local/bin/wait-for-internet.sh
  - DEBIAN_FRONTEND=noninteractive apt-get update
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
